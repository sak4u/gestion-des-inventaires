pipeline {
    agent any
    tools {
        nodejs 'NodeJS 20'
    }
    environment {
        BACKEND_DIR     = "${env.WORKSPACE}\\backend"
        API_REPORTS_DIR = "${env.WORKSPACE}\\backend\\test\\reports"
        NODE_ENV        = 'test'
        DB_URL_TEST     = credentials('DB_URL_TEST')
        JWT_SECRET_TEST = credentials('JWT_SECRET_TEST')
    }
    triggers {
        pollSCM('')  // Déclenché par le webhook GitHub push
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
        ansiColor('xterm')
        timestamps()
    }
    parameters {
        booleanParam(
            name: 'FORCE',
            defaultValue: false,
            description: 'Forcer le pipeline même sans nouveau commit (ex: après MAJ credentials)'
        )
        booleanParam(
            name: 'WITH_COVERAGE',
            defaultValue: true,
            description: 'Générer le rapport de couverture de code (lcov)'
        )
        booleanParam(
            name: 'RUN_NEWMAN',
            defaultValue: true,
            description: 'Exécuter les tests Postman via Newman'
        )
        booleanParam(
            name: 'RUN_BDD',
            defaultValue: true,
            description: 'Exécuter les scénarios Cucumber BDD'
        )
    }

    stages {
        stage('Filter Changes') {
            when {
                allOf {
                    expression { env.BUILD_NUMBER != '1' }
                    expression { !params.FORCE }
                    expression {
                        // git diff-tree (robuste : changeset Jenkins échoue si changelog vide après git clean -fdx)
                        def rc = bat(
                            script: "git diff-tree --no-commit-id -r --name-only HEAD 2>nul | findstr /b /l /c:\"backend/\" /c:\"Jenkinsfile.api\"",
                            returnStatus: true
                        )
                        // rc 0 = changements trouvés → ne pas ignorer (return false)
                        // rc 1 = aucun changement → ignorer (return true)
                        // rc >= 2 = erreur inattendue → ne pas ignorer (return false)
                        if (rc >= 2) return false
                        return rc == 1
                    }
                }
            }
            steps {
                echo '  \u2716 Aucun changement dans backend/ ou Jenkinsfile.api — pipeline ignoré'
                error('Pipeline arrêté : seuls les changements dans backend/ ou Jenkinsfile.api déclenchent ce job')
            }
        }

        stage('Environment Check') {
            steps {
                bat """
                    node --version > nul 2>&1
                    call npm --version > nul 2>&1
                    call newman --version > nul 2>&1
                """
            }
            post {
                success { echo '\u001B[32m  \u2714 Environment Check\u001B[0m' }
                failure { echo '\u001B[31m  \u2718 Environment Check\u001B[0m' }
            }
        }

        stage('Prepare Environment') {
            steps {
                writeFile file: "${env.BACKEND_DIR}\\.env.test", text: "DATABASE_URL=${env.DB_URL_TEST}\nJWT_SECRET=${env.JWT_SECRET_TEST}\nJWT_EXPIRES_IN=1h\nMAIL_HOST=localhost\nMAIL_PORT=1025\nMAIL_USER=\nMAIL_PASS=\nMAIL_FROM=test@test.com\n"
                bat "find /c /v \"\" \"%BACKEND_DIR%\\.env.test\""
            }
            post {
                success { echo '\u001B[32m  \u2714 Prepare Environment\u001B[0m' }
                failure { echo '\u001B[31m  \u2718 Prepare Environment — failed to create .env.test\u001B[0m' }
            }
        }

        stage('Install Dependencies') {
            steps {
                bat """
                    cd /d "%BACKEND_DIR%"
                    call npm install --prefer-offline 2>&1
                    if not exist "test\\reports" mkdir "test\\reports" > nul 2>&1
                    :: Pre-populer le cache Prisma Engine (mode offline : Jenkins n'a pas accès à binaries.prisma.sh)
                    set PRISMA_ENGINE_HASH=a9055b89e58b4b5bfb59600785423b1db3d0e75d
                    set PRISMA_CACHE_DIR=%USERPROFILE%\\.cache\\prisma\\master\\%PRISMA_ENGINE_HASH%
                    :: Vérifier si le cache est déjà popule (persistant entre les builds sur l'agent)
                    if exist "%PRISMA_CACHE_DIR%\\schema-engine-windows.exe" (
                        echo [CACHE] Engine Prisma deja en cache
                    ) else (
                        mkdir "%PRISMA_CACHE_DIR%" > nul 2>&1
                        if exist "node_modules\\@prisma\\engines\\schema-engine-windows.exe" (
                            copy /Y "node_modules\\@prisma\\engines\\schema-engine-windows.exe" "%PRISMA_CACHE_DIR%\\" > nul 2>&1
                            copy /Y "node_modules\\@prisma\\engines\\query_engine-windows.dll.node" "%PRISMA_CACHE_DIR%\\" > nul 2>&1
                            echo [CACHE] Engine Prisma copie depuis node_modules vers le cache offline
                        ) else (
                            echo [CACHE] ERREUR: schema-engine introuvable dans node_modules
                            echo [CACHE] Solution 1: Executer 'npm install' sans --prefer-offline sur l'agent Jenkins
                            echo [CACHE] Solution 2: Telecharger manuellement le binaire (voir documentation)
                            rem Ne pas bloquer le pipeline — prisma generate echouera avec un message clair
                        )
                    )
                    :: Générer le client Prisma (nécessaire pour les enums dans les tests)
                    call npx prisma generate
                """
            }
            post {
                success { echo '\u001B[32m  \u2714 Install Dependencies\u001B[0m' }
                failure { echo '\u001B[31m  \u2718 Install Dependencies — npm install failed\u001B[0m' }
            }
        }

        stage('Unit Tests') {
            steps {
                bat """
                    cd /d "%BACKEND_DIR%"
                    :: Garantir que Prisma Client est genere avant les tests (les enums TypeCommande, EtatCommande viennent de @prisma/client)
                    call npx prisma generate
                    set JEST_JUNIT_OUTPUT_DIR=test\\reports
                    set JEST_JUNIT_OUTPUT_NAME=junit-unit.xml
                    call npm run test:ci
                """
            }
            post {
                always {
                    junit(
                        testResults:          "backend/test/reports/junit-unit.xml",
                        allowEmptyResults:     true,
                        skipPublishingChecks:  false
                    )
                    publishHTML([
                        allowMissing:          true,
                        alwaysLinkToLastBuild: true,
                        keepAll:               true,
                        reportDir:             "backend/coverage/lcov-report",
                        reportFiles:           'index.html',
                        reportName:            'Couverture Code (Jest)',
                        reportTitles:          'Code Coverage'
                    ])
                }
                success { echo '\u001B[32m  \u2714 Unit Tests\u001B[0m' }
                failure { echo '\u001B[31m  \u2718 Unit Tests — check Test Results tab\u001B[0m' }
            }
        }

        stage('E2E API') {
            steps {
                bat """
                    cd /d "%BACKEND_DIR%"

                    :: Charger DATABASE_URL depuis le fichier .env.test créé dans Prepare Environment
                    set DATABASE_URL=%DB_URL_TEST%

                    :: Appliquer le schema Prisma sur la DB de test
                    call npx prisma db push --force-reset --accept-data-loss

                    :: Injecter les donnees de test (users, produits, fournisseurs, entrepots...)
                    call npx ts-node prisma/seed-minimal.ts

                    :: Lancer les tests E2E Supertest
                    set JEST_JUNIT_OUTPUT_DIR=test\\reports
                    set JEST_JUNIT_OUTPUT_NAME=junit-e2e-supertest.xml
                    call npm run test:e2e:ci
                """
            }
            post {
                always {
                    junit(
                        testResults:       "backend/test/reports/junit-e2e-supertest.xml",
                        allowEmptyResults: true
                    )
                }
                success { echo '\u001B[32m  \u2714 E2E API\u001B[0m' }
                failure { echo '\u001B[31m  \u2718 E2E API — check Test Results tab\u001B[0m' }
            }
        }

        stage('BDD Tests') {
            when {
                expression { return params.RUN_BDD }
            }
            steps {
                bat """
                    cd /d "%BACKEND_DIR%"
                    
                    :: Definir JWT_SECRET et DATABASE_URL dans l'environnement (NestJS lit process.env directement, pas .env)
                    set JWT_SECRET=%JWT_SECRET_TEST%
                    set DATABASE_URL=%DB_URL_TEST%

                    :: Injecter les donnees de test dans la DB (utilisateurs, produits, etc.)
                    echo [BDD] Injection des donnees de test...
                    call npx ts-node prisma/seed-minimal.ts

                    :: Demarrer le serveur (/B = sans nouvelle fenetre, essentiel pour Jenkins Session 0)
                    echo [BDD] Demarrage du serveur NestJS en arriere-plan...
                    start /B cmd /c "cd /d \"%BACKEND_DIR%\" && call npm run start:dev > server.log 2>&1"
                    
                    echo [BDD] Attente que le serveur soit pret sur localhost:3000 (max 90s)...
                    :: Boucle PowerShell pure sur UNE SEULE LIGNE (evite le decoupage batch de Jenkins)
                    powershell -Command "\$t=90;\$e=0;while(\$e -lt \$t){try{\$c=New-Object System.Net.Sockets.TcpClient;\$c.Connect('localhost',3000);\$c.Close();Write-Host '[BDD] OK';exit 0}catch{Write-Host '[BDD] Attend...';Start-Sleep -Seconds 5;\$e+=5}}Write-Host '[BDD] TIMEOUT 90s';exit 1"
                    if errorlevel 1 (
                        echo [BDD] ERREUR: Serveur non demarre — voir server.log:
                        type server.log
                        for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":3000" ^| findstr "LISTENING"') do taskkill /F /PID %%a > nul 2>&1
                        exit /b 1
                    )
                    
                    :: Executer les tests BDD Cucumber
                    echo [BDD] Lancement des scenarios Cucumber...
                    call npm run test:bdd:ci
                    set BDD_EXIT=%ERRORLEVEL%
                    
                    :: Executer les tests Newman (serveur encore actif)
                    :: Note: on ne surcharge BDD_EXIT que si Newman echoue (pour ne pas masquer un echec BDD)
                    :: Note: params.RUN_NEWMAN est interpolé par Groovy avant execution du batch
                    if /i "${params.RUN_NEWMAN}"=="true" (
                        echo [BDD] Lancement des tests Newman...
                        call npm run test:postman
                        if errorlevel 1 set BDD_EXIT=%ERRORLEVEL%
                    )
                    
                    :: Arreter le serveur (par PID ecoutant sur le port 3000 — robuste meme sans fenetre)
                    echo [BDD] Arret du serveur...
                    for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":3000" ^| findstr "LISTENING"') do taskkill /F /PID %%a > nul 2>&1
                    echo [BDD] Arret termine
                    
                    exit /b %BDD_EXIT%
                """
            }
            post {
                always {
                    archiveArtifacts(
                        artifacts:         "backend/test/reports/cucumber-report.json",
                        allowEmptyArchive: true
                    )
                    publishHTML([
                        allowMissing:          true,
                        alwaysLinkToLastBuild: true,
                        keepAll:               true,
                        reportDir:             "backend/test/reports",
                        reportFiles:           "newman-report.html",
                        reportName:            'Rapport Newman — Tests API',
                        reportTitles:          'Newman API Report'
                    ])
                }
                success { echo '\u001B[32m  \u2714 BDD + Newman Tests\u001B[0m' }
                failure { echo '\u001B[31m  \u2718 BDD + Newman Tests — check reports\u001B[0m' }
            }
        }
    }

    post {
        success {
            echo '\u001B[32m\nFinished: SUCCESS\u001B[0m'
        }
        unstable {
            echo '\u001B[33m\nFinished: UNSTABLE\u001B[0m'
        }
        failure {
            echo '\u001B[31m\nFinished: FAILURE\u001B[0m'
        }
        cleanup {
            echo 'Cleanup done.'
        }
    }
}
