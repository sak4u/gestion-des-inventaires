generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════════════
//  ENUMS
// ══════════════════════════════════════════════════════════════════════

enum TypeStock {
  achat
  vente
  perte
  retour
  correction_inventaire
  transfert
}

enum EtatCommande {
  EN_COURS
  FERMEE
  LIVREE
  ANNULEE
}

enum TypeCommande {
  ACHAT
  VENTE
}

enum StatutProposition {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

// ══════════════════════════════════════════════════════════════════════
//  AUTH & USERS
// ══════════════════════════════════════════════════════════════════════

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  users       User[]
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  isActive     Boolean       @default(true)
  dateCreation DateTime      @default(now())
  role         Role          @relation(fields: [roleId], references: [id])
  roleId       String
  resetCode    String?
  resetExpires DateTime?
  commandes    Commande[]    @relation("UserOrders")
  fluxDeStocks FluxDeStock[] @relation("UserStockFlows")
}

// ══════════════════════════════════════════════════════════════════════
//  ENTREPÔT (WAREHOUSE)
//  ⚠️  stockActuelle SUPPRIMÉ — la source de vérité est
//      SUM(StockEntrepot.quantite) WHERE entrepotId = X
// ══════════════════════════════════════════════════════════════════════

model Entrepot {
  id             String          @id @default(uuid())
  nom            String
  adresse        String?
  capaciteMax    Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  fluxDeStocks   FluxDeStock[]
  stockEntrepots StockEntrepot[]
  commandes      Commande[]
}

// ══════════════════════════════════════════════════════════════════════
//  FOURNISSEUR (SUPPLIER)
// ══════════════════════════════════════════════════════════════════════

model Fournisseur {
  id                  String                @id @default(uuid())
  nom                 String
  email               String?               @unique
  telephone           String?
  adresse             String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  commandes           Commande[]            @relation("SupplierOrders")
  fournisseurProduits FournisseurProduit[]
  propositions        PropositionCommande[]
}

// ══════════════════════════════════════════════════════════════════════
//  PRODUIT (PRODUCT)
//  ⚠️  quantite JAMAIS stocké ici — le stock total se calcule via
//      SUM(StockEntrepot.quantite) WHERE produitId = X
// ══════════════════════════════════════════════════════════════════════

model Produit {
  id                  String                @id @default(uuid())
  nom                 String
  codeBare            String                @unique
  category            String
  stockAlert          Int
  prixAchatMoyen      Float                 @default(0) // CUMP
  prixVente           Float                 @default(0)
  fournisseurProduits FournisseurProduit[]
  commandesLigne      CommandeLigne[]
  fluxDeStocks        FluxDeStock[]
  predictions         Prediction[]
  propositions        PropositionCommande[]
  stockEntrepots      StockEntrepot[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

// ══════════════════════════════════════════════════════════════════════
//  FOURNISSEUR-PRODUIT (SUPPLIER-PRODUCT LINK)
// ══════════════════════════════════════════════════════════════════════

model FournisseurProduit {
  id             String      @id @default(uuid())
  prixAchat      Float       @default(0)
  delaiLivraison Int         @default(5)
  fournisseurId  String
  fournisseur    Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  produitId      String
  produit        Produit     @relation(fields: [produitId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([fournisseurId, produitId])
}

// ══════════════════════════════════════════════════════════════════════
//  COMMANDE (PURCHASE ORDER)
// ══════════════════════════════════════════════════════════════════════

model Commande {
  id             String          @id @default(uuid())
  type           TypeCommande    @default(ACHAT)
  etat           EtatCommande    @default(EN_COURS)
  dateCreation   DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  user           User            @relation("UserOrders", fields: [userId], references: [id], onDelete: Restrict)
  fournisseurId  String?
  fournisseur    Fournisseur?    @relation("SupplierOrders", fields: [fournisseurId], references: [id], onDelete: Restrict)
  entrepotId     String?
  entrepot       Entrepot?       @relation(fields: [entrepotId], references: [id], onDelete: SetNull)
  propositionId  String?         @unique
  proposition    PropositionCommande? @relation(fields: [propositionId], references: [id])
  commandesLigne CommandeLigne[]
  fluxDeStocks   FluxDeStock[]

  @@index([fournisseurId])
  @@index([userId])
  @@index([type])
}

// ══════════════════════════════════════════════════════════════════════
//  COMMANDE LIGNE (ORDER LINE)
// ══════════════════════════════════════════════════════════════════════

model CommandeLigne {
  id           String   @id @default(uuid())
  quantite     Int
  prixUnitaire Float    @default(0)
  commandeId   String
  commande     Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produitId    String
  produit      Produit  @relation(fields: [produitId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([commandeId])
  @@index([produitId])
}

// ══════════════════════════════════════════════════════════════════════
//  FLUX DE STOCK (STOCK MOVEMENT)
//  Source de vérité : chaque mouvement met à jour StockEntrepot
// ══════════════════════════════════════════════════════════════════════

model FluxDeStock {
  id            String    @id @default(uuid())
  quantite      Int
  type          TypeStock
  note          String?
  date          DateTime  @default(now())
  creerParId    String
  creerPar      User      @relation("UserStockFlows", fields: [creerParId], references: [id], onDelete: Restrict)
  produitId     String
  produit       Produit   @relation(fields: [produitId], references: [id], onDelete: Cascade)
  entrepotId    String
  entrepot      Entrepot  @relation(fields: [entrepotId], references: [id], onDelete: Cascade)
  entrepotLieId String?
  commandeId    String?
  commande      Commande? @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([produitId, date])
  @@index([entrepotId])
  @@index([type])
}

// ══════════════════════════════════════════════════════════════════════
//  PREDICTION (AI — historique conservé)
//  Plusieurs prédictions par produit pour tracer l'évolution du modèle.
//  La prédiction la plus récente est la prédiction "active".
// ══════════════════════════════════════════════════════════════════════

model Prediction {
  id                   String                @id @default(uuid())
  estimationSortieDate DateTime
  quantiteRecommande   Int
  CMJ                  Float
  methode              String                @default("hybrid")
  fiabilite            Float                 @default(0)
  explication          String                @default("")
  tendance             String                @default("stable")
  produitId            String
  produit              Produit               @relation(fields: [produitId], references: [id], onDelete: Cascade)
  propositions         PropositionCommande[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([produitId, createdAt(sort: Desc)])
}

// ══════════════════════════════════════════════════════════════════════
//  PROPOSITION COMMANDE (Smart Replenishment Suggestion)
// ══════════════════════════════════════════════════════════════════════

model PropositionCommande {
  id               String            @id @default(uuid())
  quantiteProposee Int
  dateProposition  DateTime          @default(now())
  statut           StatutProposition @default(EN_ATTENTE)
  scoreFournisseur Float             @default(0)

  produitId String
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)

  fournisseurId String
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Restrict)

  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  commande     Commande?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([produitId])
  @@index([statut])
}

// ══════════════════════════════════════════════════════════════════════
//  STOCK ENTREPÔT — SOURCE UNIQUE DE VÉRITÉ
//  Quantité d'un produit dans un entrepôt spécifique.
//  Stock total produit = SUM(quantite) GROUP BY produitId
//  Stock total entrepôt = SUM(quantite) GROUP BY entrepotId
// ══════════════════════════════════════════════════════════════════════

model StockEntrepot {
  id       String @id @default(uuid())
  quantite Int    @default(0)

  produitId String
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)

  entrepotId String
  entrepot   Entrepot @relation(fields: [entrepotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([produitId, entrepotId])
  @@index([produitId])
  @@index([entrepotId])
}
