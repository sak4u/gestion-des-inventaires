          "request": { "method": "GET", "url": "{{baseUrl}}/entrepots" }
        },
        {
          "name": "16. Supprimer entrepôt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/entrepots/{{entrepotId}}" }
        }
      ]
    },
    {
      "name": "05 — Propositions IA",
      "item": [
        {
          "name": "17. Lister toutes les propositions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/propositions" }
        },
        {
          "name": "18. Propositions EN_ATTENTE",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Toutes EN_ATTENTE', () => {",
                  "  pm.response.json().forEach(p => pm.expect(p.statut).to.eql('EN_ATTENTE'));",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/propositions/pending" }
        },
        {
          "name": "19. Déclencher vérification stocks (IA)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has checked field', () => pm.expect(pm.response.json()).to.have.property('checked'));",
                  "pm.test('Response has propositionsCreated', () => pm.expect(pm.response.json()).to.have.property('propositionsCreated'));"
                ]
              }
            }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/propositions/check-all" }
        }
      ]
    }
  ]
}
