                  "});",
                  "pm.test('Capacité correcte', () => pm.expect(pm.response.json().capaciteMax).to.eql(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/entrepots",
            "body": {
              "mode": "raw",
              "raw": "{\"nom\": \"Entrepôt Postman Test\", \"adresse\": \"Zone Test\", \"capaciteMax\": 500}"
            }
          }
        },
        {
          "name": "15. Lister entrepôts",
          "event": [
