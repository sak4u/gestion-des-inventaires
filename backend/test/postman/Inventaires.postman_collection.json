            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/fournisseurs",
            "body": {
              "mode": "raw",
              "raw": "{\"nom\": \"Fournisseur Postman Test\", \"email\": \"postman-fournisseur@test.com\", \"telephone\": \"+33600000099\"}"
            }
          }
        },
        {
          "name": "12. Lister tous les fournisseurs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
