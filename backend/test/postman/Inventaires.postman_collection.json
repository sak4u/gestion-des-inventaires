                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/fournisseurs/{{fournisseurId}}" }
        }
      ]
    },
    {
      "name": "04 — Entrepôts",
      "item": [
        {
          "name": "14. Créer un entrepôt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
