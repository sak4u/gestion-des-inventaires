{
  "info": {
    "name": "Gestion des Inventaires — API Tests",
    "description": "Collection complète de tests API pour le système de gestion des inventaires.\nCredentials seed : admin@email.com / admin123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login avant chaque requête si le token est absent",
          "if (!pm.environment.get('token')) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('baseUrl') + '/auth/login',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: {",
          "      mode: 'raw',",
          "      raw: JSON.stringify({",
          "        email: pm.environment.get('adminEmail'),",
          "        password: pm.environment.get('adminPass')",
          "      })",
          "    }",
          "  }, function (err, res) {",
          "    if (!err && res.code === 200) {",
          "      pm.environment.set('token', res.json().access_token);",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 — Authentification",
      "item": [
        {
          "name": "01. Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has access_token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('access_token');",
                  "  pm.environment.set('token', json.access_token);",
                  "});",
                  "pm.test('User role is ADMIN', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.user.role.name).to.eql('ADMIN');",
                  "  pm.environment.set('adminUserId', json.user.id);",
                  "});",
                  "pm.test('Response time < 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPass}}\"}"
            }
          }
        },
        {
          "name": "02. Login — Mauvais mot de passe (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\": \"admin@email.com\", \"password\": \"MauvaisPass\"}" }
          }
        },
        {
          "name": "03. Profil connecté",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has email', () => pm.expect(pm.response.json()).to.have.property('email'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "04. Lister utilisateurs (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('At least 3 users', () => pm.expect(pm.response.json().length).to.be.gte(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/users"
          }
        },
        {
          "name": "05. Mot de passe oublié",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has message', () => pm.expect(pm.response.json()).to.have.property('message'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/forgot-password",
            "body": { "mode": "raw", "raw": "{\"email\": \"admin@email.com\"}" }
          }
        }
      ]
    },
    {
      "name": "02 — Produits",
      "item": [
        {
          "name": "06. Créer un produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has id', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.environment.set('produitId', json.id);",
                  "});",
                  "pm.test('Nom correct', () => pm.expect(pm.response.json().nom).to.eql('Clavier Mécanique Test'));",
                  "pm.test('Response time < 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/produits",
            "body": {
              "mode": "raw",
              "raw": "{\"nom\": \"Clavier Mécanique Test\", \"codeBare\": \"KBD-POSTMAN-001\", \"category\": \"Informatique\", \"stockAlert\": 5, \"prixAchatMoyen\": 45.00, \"prixVente\": 79.99}"
            }
          }
        },
        {
          "name": "07. Lister tous les produits",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/produits"
          }
        },
        {
          "name": "08. Détail produit par ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('ID correspond', () => pm.expect(pm.response.json().id).to.eql(pm.environment.get('produitId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/produits/{{produitId}}"
          }
        },
        {
          "name": "09. Modifier prix produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Prix mis à jour', () => pm.expect(pm.response.json().prixVente).to.eql(99.99));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/produits/{{produitId}}",
            "body": { "mode": "raw", "raw": "{\"prixVente\": 99.99}" }
          }
        },
        {
          "name": "10. Supprimer produit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/produits/{{produitId}}"
          }
        }
      ]
    },
    {
      "name": "03 — Fournisseurs",
      "item": [
        {
          "name": "11. Créer un fournisseur",
          "event": [
            {
              "listen": "test",
