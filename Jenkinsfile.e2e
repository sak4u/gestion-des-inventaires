pipeline {
    agent any
    tools {
        nodejs 'NodeJS 20'
    }
    environment {
        SELENIUM_DIR   = "${env.WORKSPACE}\\selenium-tests"
        REPORTS_DIR    = "${env.WORKSPACE}\\selenium-tests\\reports"
        BACKEND_DIR    = "${env.WORKSPACE}\\backend"
        FRONTEND_DIR   = "${env.WORKSPACE}\\frontend"
        PYTHON         = "python"
        BACKEND_URL    = 'http://localhost:3000'
        FRONTEND_URL   = 'http://localhost:5173'
        DB_URL_TEST     = credentials('DB_URL_TEST')
        JWT_SECRET_TEST = credentials('JWT_SECRET_TEST')
    }
    triggers {
        pollSCM('')  // Déclenché par le webhook GitHub push
    }
    options {
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '5'))
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        ansiColor('xterm')
        timestamps()
    }
    parameters {
        booleanParam(
            name: 'HEADLESS',
            defaultValue: true,
            description: 'Exécuter Chrome en mode headless (true = sans fenêtre)'
        )
        choice(
            name: 'SELENIUM_SUITE',
            choices: ['ALL', 'SMOKE', 'LOGIN', 'PRODUITS', 'REGRESSION'],
            description: 'Suite de tests Selenium à exécuter'
        )
        booleanParam(
            name: 'SKIP_CONNECTIVITY_CHECK',
            defaultValue: false,
            description: 'Ignorer la vérification de connectivité (si services déjà vérifiés)'
        )
    }

    stages {
        stage('Filter Changes') {
            when {
                allOf {
                    expression { env.BUILD_NUMBER != '1' }
                    not { anyOf { changeset "selenium-tests/**"; changeset "frontend/**"; changeset "Jenkinsfile.e2e" } }
                }
            }
            steps {
                echo '  \u2716 Aucun changement dans selenium-tests/, frontend/ ou Jenkinsfile.e2e — pipeline ignoré'
                error('Pipeline arrêté : seuls les changements dans selenium-tests/, frontend/ ou Jenkinsfile.e2e déclenchent ce job')
            }
        }

        stage('Environment Check') {
            steps {
                bat """
                    "%PYTHON%" --version > nul 2>&1
                    "%PYTHON%" -m pip --version > nul 2>&1
                    node --version > nul 2>&1
                    npm --version > nul 2>&1
                """
            }
            post {
                success { echo '\u001B[32m  \u2714 Environment Check\u001B[0m' }
                failure { echo '\u001B[31m  \u2718 Environment Check\u001B[0m' }
            }
        }

        stage('Install Dependencies') {
            steps {
                bat """
                    cd /d "%SELENIUM_DIR%"
                    "%PYTHON%" -m pip install -r requirements.txt --quiet > nul 2>&1
                    if not exist "reports" mkdir "reports" > nul 2>&1
                    if not exist "reports\\allure-results" mkdir "reports\\allure-results" > nul 2>&1
                """
            }
            post {
                success { echo '\u001B[32m  \u2714 Install Dependencies\u001B[0m' }
                failure { echo '\u001B[31m  \u2718 Install Dependencies — pip install failed\u001B[0m' }
            }
        }

        stage('E2E API') {
            when {
                expression { return !params.SKIP_CONNECTIVITY_CHECK }
            }
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    bat """
                        echo [CHECK] Verification de la connectivite backend/frontend...
                        curl -f -s --max-time 10 "%BACKEND_URL%" > nul 2>&1
                        curl -f -s --max-time 10 "%FRONTEND_URL%" > nul 2>&1
                        echo [CHECK] Backend + Frontend sont accessibles
                    """
                }
            }
            post {
                success { echo '\u001B[32m  \u2714 E2E API — backend & frontend accessibles\u001B[0m' }
                unstable { echo '\u001B[33m  \u26A0 E2E API — backend/frontend unreachable (tests Selenium ignores)\u001B[0m' }
                failure { echo '\u001B[31m  \u2718 E2E API — erreur inattendue\u001B[0m' }
            }
        }

        stage('BDD Tests') {
            environment {
                HEADLESS_MODE = "${params.HEADLESS}"
            }
            steps {
                script {
                    def suiteMarker = ''
                    if (params.SELENIUM_SUITE == 'SMOKE')      suiteMarker = '-m smoke'
                    if (params.SELENIUM_SUITE == 'LOGIN')      suiteMarker = '-m login'
                    if (params.SELENIUM_SUITE == 'PRODUITS')   suiteMarker = '-m produits'
                    if (params.SELENIUM_SUITE == 'REGRESSION') suiteMarker = '-m regression'

                    bat """
                        :: ========== 1. DEMARRAGE BACKEND NESTJS ==========
                        cd /d "%BACKEND_DIR%"
                        echo [E2E] Installation des dependances backend...
                        npm install --prefer-offline 2>&1
                        npx prisma generate

                        :: Definir les variables d'env pour le backend
                        set JWT_SECRET=%JWT_SECRET_TEST%
                        set DATABASE_URL=%DB_URL_TEST%

                        :: Initialiser la DB de test avec le schema + seed
                        echo [E2E] Initialisation de la base de test...
                        npx prisma db push --force-reset --accept-data-loss
                        npx ts-node prisma/seed-minimal.ts

                        :: Demarrer le serveur NestJS
                        echo [E2E] Demarrage du backend NestJS...
                        start "NestJS-Server" cmd /c "npm run start:dev > server.log 2>&1"

                        :: ========== 2. DEMARRAGE FRONTEND VITE ==========
                        cd /d "%FRONTEND_DIR%"
                        echo [E2E] Installation des dependances frontend...
                        npm install --prefer-offline 2>&1
                        echo [E2E] Demarrage du frontend Vite...
                        start "Vite-Server" cmd /c "npm run dev > frontend.log 2>&1"

                        :: ========== 3. ATTENTE DES DEUX SERVICES ==========
                        :: Attente backend port 3000
                        echo [E2E] Attente du backend sur localhost:3000 (max 120s)...
                        powershell -Command "\$t=120;\$e=0;while(\$e -lt \$t){try{\$c=New-Object System.Net.Sockets.TcpClient;\$c.Connect('localhost',3000);\$c.Close();Write-Host '[E2E] Backend OK';exit 0}catch{Start-Sleep -Seconds 5;\$e+=5}}exit 1"
                        if errorlevel 1 (
                            echo [E2E] ERREUR: Backend non demarre — voir server.log:
                            type "%BACKEND_DIR%\\server.log"
                            taskkill /F /FI "WINDOWTITLE eq NestJS-Server*" > nul 2>&1
                            exit /b 1
                        )

                        :: Attente frontend port 5173
                        echo [E2E] Attente du frontend sur localhost:5173 (max 120s)...
                        powershell -Command "\$t=120;\$e=0;while(\$e -lt \$t){try{\$c=New-Object System.Net.Sockets.TcpClient;\$c.Connect('localhost',5173);\$c.Close();Write-Host '[E2E] Frontend OK';exit 0}catch{Start-Sleep -Seconds 5;\$e+=5}}exit 1"
                        if errorlevel 1 (
                            echo [E2E] ERREUR: Frontend non demarre — voir frontend.log:
                            type "%FRONTEND_DIR%\\frontend.log"
                            taskkill /F /FI "WINDOWTITLE eq NestJS-Server*" > nul 2>&1
                            taskkill /F /FI "WINDOWTITLE eq Vite-Server*" > nul 2>&1
                            exit /b 1
                        )

                        :: ========== 4. TESTS SELENIUM ==========
                        cd /d "%SELENIUM_DIR%"
                        if exist "reports\\allure-results" (
                            rmdir /s /q "reports\\allure-results" > nul 2>&1
                            mkdir "reports\\allure-results" > nul 2>&1
                        )
                        echo [E2E] Lancement des tests Selenium...
                        "%PYTHON%" -m pytest tests/ ${suiteMarker} --alluredir=reports\\allure-results --html=reports\\report.html --self-contained-html --junitxml=reports\\junit-e2e.xml -q --tb=line
                        set E2E_EXIT_CODE=%ERRORLEVEL%
                        echo [E2E] pytest exit code: %E2E_EXIT_CODE%

                        :: ========== 5. ARRET DES SERVEURS ==========
                        echo [E2E] Arret du backend...
                        taskkill /F /FI "WINDOWTITLE eq NestJS-Server*" > nul 2>&1
                        echo [E2E] Arret du frontend...
                        taskkill /F /FI "WINDOWTITLE eq Vite-Server*" > nul 2>&1
                        echo [E2E] Arret termine

                        exit /b %E2E_EXIT_CODE%
                    """
                }
            }
            post {
                always {
                    allure([
                        includeProperties: true,
                        jdk:               '',
                        results:           [[path: "${env.WORKSPACE}\\selenium-tests\\reports\\allure-results"]]
                    ])
                    junit(
                        testResults:       "${env.WORKSPACE}\\selenium-tests\\reports\\junit-e2e.xml",
                        allowEmptyResults: true
                    )
                    publishHTML([
                        allowMissing:          true,
                        alwaysLinkToLastBuild: true,
                        keepAll:               true,
                        reportDir:             "${env.WORKSPACE}\\selenium-tests\\reports",
                        reportFiles:           'report.html',
                        reportName:            'Rapport HTML — Tests Selenium',
                        reportTitles:          'Selenium E2E Report'
                    ])
                    archiveArtifacts(
                        artifacts:         "${env.WORKSPACE}\\selenium-tests\\reports\\screenshots\\*.png",
                        allowEmptyArchive: true
                    )
                }
                success { echo '\u001B[32m  \u2714 BDD Tests\u001B[0m' }
                unstable { echo '\u001B[33m  \u26A0 BDD Tests — intentional failures detected\u001B[0m' }
                failure { echo '\u001B[31m  \u2718 BDD Tests — check Allure Report\u001B[0m' }
            }
        }

        stage('Newman Tests') {
            steps {
                echo '\u001B[32m  \u2714 Newman Tests — N/A for E2E pipeline\u001B[0m'
            }
        }
    }

    post {
        success {
            echo '\u001B[32m\nFinished: SUCCESS\u001B[0m'
        }
        unstable {
            echo '\u001B[33m\nFinished: UNSTABLE\u001B[0m'
        }
        failure {
            echo '\u001B[31m\nFinished: FAILURE\u001B[0m'
        }
        cleanup {
            echo 'Cleanup done.'
        }
    }
}
